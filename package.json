{
  "name": "ivxray",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "IVXray - Pokémon IV & stat calculators (Gen 3–9). Static site built with Astro, deployable on Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-pokedex.mjs --if-missing && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:pokedex": "node scripts/fetch-pokedex.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "astro": "^5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
