---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 36 36" fill="none" aria-hidden="true">
  <g stroke="#3b5bdb" stroke-width="2" stroke-linecap="round">
    <line x1="18" y1="1" x2="18" y2="4.5"></line>
    <line x1="18" y1="31.5" x2="18" y2="35"></line>
    <line x1="1" y1="18" x2="4.5" y2="18"></line>
    <line x1="31.5" y1="18" x2="35" y2="18"></line>
  </g>
  <circle cx="18" cy="18" r="13" fill="#ffffff" stroke="#14161f" stroke-width="2.5"></circle>
  <path d="M5 18 A13 13 0 0 1 31 18 Z" fill="#ee1515"></path>
  <rect x="6.4" y="16.6" width="23.2" height="2.8" fill="#14161f"></rect>
  <circle cx="18" cy="18" r="5" fill="#ffffff" stroke="#14161f" stroke-width="2.5"></circle>
  <circle cx="18" cy="18" r="1.9" fill="#3b5bdb"></circle>
