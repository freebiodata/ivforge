---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

const nav: { href: string; label: string; icon: IconName }[] = [
  { href: '/iv-calculator/', label: 'IV Calc', icon: 'scan-line' },
  { href: '/stat-calculator/', label: 'Stat Calc', icon: 'gauge' },
  { href: '/iv-judge/', label: 'IV Judge', icon: 'badge-check' },
  { href: '/hidden-power/', label: 'Hidden Power', icon: 'sparkles' },
  { href: '/pokedex/', label: 'Pokédex', icon: 'book-open' },
  { href: '/about/', label: 'About', icon: 'flask-conical' },
];

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (here === href.replace(/\/+$/, '') ? 'page' : undefined);
---
<div class="scan-rule"></div>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="IVXray home">
      <Logo size={30} />
      <span class="brand__word">IV<b>X</b>ray</span>
      <span class="brand__tag">Gen 3–9</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href)}>
          <Icon name={item.icon} size={13} />
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
